<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_ripple">
    <item>
        <selector>
            <item android:state_selected="true"><shape><solid android:color="@color/accent_container" />
                <stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
            <item><shape><solid android:color="@color/white" />
                <stroke android:width="1dp" android:color="@color/line" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
        </selector>
    </item>
</ripple>
