<?xml version="1.0" encoding="utf-8"?>
<!-- Field variant for grey page backgrounds, where the filled style would disappear. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/white" /><stroke android:width="1.5dp" android:color="@color/accent" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
    <item><shape><solid android:color="@color/white" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
</selector>
