<?xml version="1.0" encoding="utf-8"?>
<!-- Filled field; containers use addStatesFromChildren so the focus ring follows the inner EditText. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/white" /><stroke android:width="1.5dp" android:color="@color/accent" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
    <item><shape><solid android:color="@color/field" /><stroke android:width="1.5dp" android:color="@color/field" /><corners android:radius="@dimen/ui_radius_control" /></shape></item>
</selector>
