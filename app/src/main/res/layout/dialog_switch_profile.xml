<?xml version="1.0" encoding="utf-8"?>
<com.lightboat.app.ProfileSwitchLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_config_dialog"
    android:paddingTop="20dp" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingVertical="4dp">
            <TextView android:id="@+id/switchTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/switch_configuration" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/switchSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/closeSwitch" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_close" app:tint="@color/muted" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_profile_switch" />
    </LinearLayout>
    <LinearLayout android:id="@+id/searchPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:background="@drawable/bg_config_secondary"
        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="0dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search"
            android:importantForAccessibility="no" />
        <EditText android:id="@+id/searchProfiles" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="50dp" android:paddingHorizontal="12dp" android:paddingVertical="12dp" android:background="@null"
            android:hint="@string/search_profiles" android:textSize="15sp" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:singleLine="true" android:inputType="text|textNoSuggestions"
            android:imeOptions="actionDone|flagNoExtractUi" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/clearSearch" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_close" app:tint="@color/muted" android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" android:contentDescription="@string/clear_profile_search" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:paddingHorizontal="20dp" android:gravity="center_vertical">
        <Button android:id="@+id/categoryFilter" style="@style/CategoryFilter" android:layout_width="0dp" android:layout_weight="1" />
        <Button android:id="@+id/favoriteFilter" style="@style/FavoriteFilter" android:layout_marginStart="8dp" />
    </LinearLayout>
    <!-- Measure complete cards before assigning the remaining space to the scrollable list. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginTop="16dp" android:minHeight="96dp" tools:ignore="InefficientWeight">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/switchList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingBottom="4dp"
            android:clipToPadding="false" android:scrollbars="vertical" />
        <LinearLayout android:id="@+id/noProfilesFound" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="24dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/profiles_filter_empty" android:textColor="@color/ink" android:textSize="16sp"
                android:gravity="center" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/profiles_filter_search_hint" android:textColor="@color/muted" android:textSize="13sp" android:gravity="center" />
            <Button android:id="@+id/resetFilters" style="@style/ConfigAction" android:layout_width="wrap_content"
                android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/profiles_reset_filters" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/switchFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="20dp">
        <TextView android:id="@+id/startupNote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/profile_switch_startup_note" android:textColor="@color/muted" android:textSize="12sp"
            android:gravity="center" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</com.lightboat.app.ProfileSwitchLayout>
