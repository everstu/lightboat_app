<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_config_dialog">
        <TextView android:id="@+id/libraryTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/script_library" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" />
    <TextView android:id="@+id/libraryHelp" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/script_library_help" android:textColor="@color/muted"
        android:textSize="13sp" android:lineSpacingExtra="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <Button android:id="@+id/newLibraryScript" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:paddingHorizontal="12dp"
            android:textSize="13sp" android:singleLine="true" android:text="@string/script_new" />
        <Button android:id="@+id/batchAddLibraryScripts" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="12dp" android:paddingHorizontal="12dp"
            android:textSize="13sp" android:singleLine="true" android:text="@string/script_batch_add" />
    </LinearLayout>
    <TextView android:id="@+id/emptyScriptLibrary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/script_library_empty" android:textColor="@color/muted" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/libraryList" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <Button android:id="@+id/cancelLibrary" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/import_cancel" />
        <Button android:id="@+id/saveLibrary" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="12dp" android:text="@string/save_profile" />
    </LinearLayout>
</LinearLayout>
