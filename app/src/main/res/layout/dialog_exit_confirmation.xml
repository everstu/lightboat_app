<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="24dp" android:background="@drawable/bg_config_dialog">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:padding="13dp"
                android:background="@drawable/bg_config_soft" android:src="@drawable/ic_exit" android:importantForAccessibility="no" />
            <TextView android:id="@+id/exitTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/exit_title" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/exitMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/exit_message" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="5dp" />
            <LinearLayout android:id="@+id/nextProfilePanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="vertical" android:background="@drawable/bg_config_secondary" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/exit_next_profile"
                    android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/nextProfileName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/nextProfileHost" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="middle" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
        <Button android:id="@+id/confirmExit" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/exit" android:textColor="@color/ink" />
        <Button android:id="@+id/cancelExit" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginStart="12dp" android:text="@string/stay" />
    </LinearLayout>
</LinearLayout>
