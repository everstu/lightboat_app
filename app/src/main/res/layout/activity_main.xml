<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper">

    <LinearLayout android:id="@+id/titleBar" android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/app_name" android:textColor="@color/ink" android:textSize="22sp"
            android:textStyle="bold" android:letterSpacing="0.06" />
        <ImageButton android:id="@+id/refreshButton" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh"
            android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
        <ImageButton android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_settings" android:contentDescription="@string/settings"
            android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:id="@+id/contentArea" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/browserPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone"
            android:background="@color/white">
            <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp" android:max="100"
                android:progressTint="@color/accent" android:visibility="gone" />
            <FrameLayout android:id="@+id/webContainer" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout android:id="@+id/configPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:focusableInTouchMode="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:paddingHorizontal="12dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/cancelButton" android:layout_width="48dp" android:layout_height="48dp"
                    android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_close_editor" />
                <TextView android:id="@+id/configTitle" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="@string/setup_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" />
            </LinearLayout>
            <ScrollView android:id="@+id/editorScroll" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
                    <TextView android:id="@+id/configDescription" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
                        android:text="@string/setup_description" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    <TextView style="@style/FieldLabel" android:text="@string/profile_basics" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_profile" android:padding="16dp">
                        <TextView style="@style/FieldLabel" android:text="@string/profile_name" android:labelFor="@id/nameInput" />
                        <EditText android:id="@+id/nameInput" style="@style/UrlField" android:inputType="textCapSentences"
                            android:hint="@string/profile_name_hint" android:maxLength="60" android:imeOptions="actionNext" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:gravity="center_vertical">
                            <TextView style="@style/FieldLabel" android:layout_width="0dp" android:layout_weight="1"
                                android:text="@string/website_label" android:labelFor="@id/websiteInput" />
                            <ImageButton android:id="@+id/scanWebsiteButton" android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_scan" android:contentDescription="@string/scan_website"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </LinearLayout>
                        <EditText android:id="@+id/websiteInput" style="@style/UrlField" android:layout_marginTop="0dp"
                            android:hint="@string/website_hint" android:imeOptions="actionNext" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:gravity="center_vertical">
                            <TextView style="@style/FieldLabel" android:layout_width="0dp" android:layout_weight="1"
                                android:text="@string/script_label" android:labelFor="@id/scriptInput" />
                            <ImageButton android:id="@+id/scanScriptButton" android:layout_width="48dp" android:layout_height="48dp"
                                android:src="@drawable/ic_scan" android:contentDescription="@string/scan_script"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </LinearLayout>
                        <EditText android:id="@+id/scriptInput" style="@style/UrlField" android:layout_marginTop="0dp"
                            android:hint="@string/script_hint" android:imeOptions="actionDone" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/script_help"
                            android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <TextView style="@style/FieldLabel" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
                        android:text="@string/profile_access" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_profile" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/platform_help" android:textColor="@color/muted" android:textSize="13sp" android:lineSpacingExtra="3dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                            <Button android:id="@+id/applePlatformButton" style="@style/ConfigSegment" android:layout_width="0dp"
                                android:layout_weight="1" android:layout_height="48dp" android:text="@string/platform_apple" />
                            <Button android:id="@+id/androidPlatformButton" style="@style/ConfigSegment" android:layout_width="0dp"
                                android:layout_weight="1" android:layout_height="48dp" android:layout_marginHorizontal="8dp" android:text="@string/platform_android" />
                            <Button android:id="@+id/windowsPlatformButton" style="@style/ConfigSegment" android:layout_width="0dp"
                                android:layout_weight="1" android:layout_height="48dp" android:text="@string/platform_windows" />
                        </LinearLayout>
                        <TextView style="@style/FieldLabel" android:layout_marginTop="20dp"
                            android:text="@string/user_agent_label" android:labelFor="@id/userAgentInput" />
                        <EditText android:id="@+id/userAgentInput" style="@style/UrlField" android:textSize="13sp" android:fontFamily="monospace"
                            android:inputType="textMultiLine|textNoSuggestions" android:singleLine="false"
                            android:minLines="3" android:maxLines="6" android:maxLength="2048" android:gravity="top|start"
                            android:hint="@string/user_agent_label" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/profile_ua_hint" android:textSize="12sp" android:textColor="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                    android:text="@string/setup_note" android:textSize="12sp" android:textColor="@color/muted" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/saveButton" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="52dp" android:text="@string/save_profile" />
                    <Button android:id="@+id/saveOpenButton" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="52dp" android:layout_marginStart="12dp" android:text="@string/save_open" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout android:id="@+id/profilesPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:paddingTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="24dp" android:paddingEnd="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/profiles_title" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" />
                    <ImageButton android:id="@+id/returnButton" android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/ic_back" android:contentDescription="@string/cancel"
                        android:background="?attr/selectableItemBackgroundBorderless" android:visibility="gone" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp" android:layout_marginTop="4dp" android:text="@string/profiles_note"
                    android:textColor="@color/muted" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp" android:layout_marginTop="24dp">
                    <Button android:id="@+id/importButton" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="52dp" android:drawableStart="@drawable/ic_import" android:drawablePadding="8dp" android:text="@string/import_config" />
                    <Button android:id="@+id/exportButton" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="52dp" android:layout_marginStart="12dp" android:drawableStart="@drawable/ic_export"
                        android:drawablePadding="8dp" android:text="@string/export_config" />
                </LinearLayout>
                <LinearLayout android:id="@+id/profilesSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:paddingHorizontal="24dp" android:paddingBottom="12dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/profileCount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/profiles_sort_hint" android:textColor="@color/muted" android:textSize="12sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/profilesList" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:paddingHorizontal="20dp"
                        android:paddingBottom="100dp" android:clipToPadding="false" android:scrollbars="vertical" />
                    <ScrollView android:id="@+id/emptyProfiles" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:paddingHorizontal="32dp" android:paddingVertical="28dp">
                            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_config_soft"
                                android:padding="16dp" android:src="@drawable/ic_profiles" android:importantForAccessibility="no" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                                android:text="@string/empty_profiles" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/ink" android:gravity="center" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="@string/profiles_empty_note" android:textSize="14sp" android:textColor="@color/muted" android:gravity="center" android:lineSpacingExtra="4dp" />
                            <Button android:id="@+id/emptyAddButton" style="@style/ConfigPrimary" android:layout_width="match_parent" android:layout_height="54dp"
                                android:layout_marginTop="28dp" android:text="@string/add_profile" />
                            <Button android:id="@+id/emptyImportButton" style="@style/ConfigAction" android:layout_width="match_parent"
                                android:layout_height="52dp" android:layout_marginTop="6dp" android:text="@string/profiles_empty_import" />
                        </LinearLayout>
                    </ScrollView>
                </FrameLayout>
                <TextView android:id="@+id/versionLabel" android:layout_width="match_parent" android:layout_height="44dp"
                    android:paddingHorizontal="24dp" android:gravity="center_vertical" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>
            <Button android:id="@+id/addButton" style="@style/ConfigPrimary" android:layout_width="wrap_content" android:layout_height="56dp"
                android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="24dp"
                android:drawableStart="@drawable/ic_add" android:drawablePadding="8dp" android:text="@string/add_profile"
                android:paddingHorizontal="20dp" android:elevation="6dp" />
        </FrameLayout>

        <LinearLayout android:id="@+id/statusPanel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"
            android:padding="32dp" android:background="@color/paper" android:visibility="gone">
            <ProgressBar android:id="@+id/statusSpinner" android:layout_width="40dp" android:layout_height="40dp"
                android:indeterminateTint="@color/accent" />
            <TextView android:id="@+id/statusTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center"
                android:text="@string/preparing" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/ink" />
            <TextView android:id="@+id/statusDetail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
                android:text="@string/preparing_note" android:textSize="15sp" android:textColor="@color/muted"
                android:lineSpacingExtra="5dp" />
            <Button android:id="@+id/retryButton" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="24dp" android:text="@string/retry" android:textColor="@color/white"
                android:backgroundTint="@color/accent" android:visibility="gone" />
            <Button android:id="@+id/editButton" android:layout_width="match_parent" android:layout_height="52dp"
                style="?attr/borderlessButtonStyle" android:text="@string/edit_addresses"
                android:textColor="@color/accent" android:visibility="gone" />
            <Button android:id="@+id/debugLogButton" android:layout_width="match_parent" android:layout_height="52dp"
                style="?attr/borderlessButtonStyle" android:text="@string/debug_logs"
                android:textColor="@color/accent" />
        </LinearLayout>
        <FrameLayout android:id="@+id/menuLayer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:clipChildren="true" android:clipToPadding="true">
            <com.lightboat.app.EdgeMenuButton android:id="@+id/edgeMenuButton" android:layout_width="48dp"
                android:layout_height="48dp" android:src="@drawable/ic_menu" android:padding="13dp"
                android:background="@drawable/bg_menu_button" android:contentDescription="@string/browser_menu"
                android:elevation="0dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
