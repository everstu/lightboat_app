<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:orientation="vertical" android:background="@drawable/bg_profile" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/profileName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="19sp" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" />
        <ImageButton android:id="@+id/favoriteProfile" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="@string/profile_favorite" android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/dragHandle" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_drag" android:contentDescription="@string/drag_profile"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/profileMore" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_more" android:contentDescription="@string/profile_more" android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/profileBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_config_soft" android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:textSize="11sp" android:textColor="@color/accent" />
        <TextView android:id="@+id/profileState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textSize="12sp" android:textColor="@color/accent" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/profileCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="12sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/profileUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:textSize="14sp" android:textColor="@color/ink"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/profileScript" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="middle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
        <Button android:id="@+id/openProfile" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:text="@string/switch_profile" />
        <Button android:id="@+id/editProfile" style="@style/ConfigAction" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/edit" />
        <Button android:id="@+id/topProfile" style="@style/ConfigAction" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/profile_move_top" />
    </LinearLayout>
</LinearLayout>
