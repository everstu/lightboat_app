<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/ui_page_inset" android:background="@drawable/bg_config_dialog">
    <TextView android:id="@+id/updateTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/update_title" android:textSize="@dimen/ui_dialog_title" android:textStyle="bold" android:textColor="@color/ink" />
    <TextView android:id="@+id/updateCurrent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/muted" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
        android:scrollbars="none" android:layout_marginTop="@dimen/ui_section_gap">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="@dimen/ui_body_text" android:textColor="@color/ink" android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/updateProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp"
                android:indeterminate="true" android:progressTint="@color/accent" android:indeterminateTint="@color/accent" />
            <LinearLayout android:id="@+id/updateDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="@dimen/ui_section_gap" android:padding="@dimen/ui_field_inset"
                android:background="@drawable/bg_config_soft" android:visibility="gone">
                <TextView style="@style/FieldLabel" android:text="@string/update_notes" />
                <TextView android:id="@+id/updateNotes" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="@dimen/ui_label_text"
                    android:lineSpacingExtra="3dp" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_item_gap" android:orientation="horizontal">
        <Button android:id="@+id/updateClose" style="@style/ConfigSecondary" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/close" />
        <Button android:id="@+id/updateAction" style="@style/ConfigPrimary" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/ui_item_gap"
            android:text="@string/update_check" />
    </LinearLayout>
</LinearLayout>
