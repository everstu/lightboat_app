<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="@dimen/ui_page_inset" android:orientation="vertical">
    <TextView android:id="@+id/importTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/import_config" android:textSize="@dimen/ui_dialog_title" android:textStyle="bold" android:textColor="@color/ink" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginTop="@dimen/ui_item_gap" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/import_description" android:textColor="@color/muted" android:textSize="@dimen/ui_label_text" android:lineSpacingExtra="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_section_gap">
                <Button android:id="@+id/urlSource" style="@style/ConfigSegment" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:layout_marginEnd="8dp" android:text="@string/import_source_url" />
                <Button android:id="@+id/fileSource" style="@style/ConfigSegment" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:text="@string/import_source_file" />
            </LinearLayout>
            <LinearLayout android:id="@+id/urlPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="@dimen/ui_section_gap">
                <TextView style="@style/FieldLabel" android:text="@string/import_url_label" android:labelFor="@id/importUrl" />
                <EditText android:id="@+id/importUrl" style="@style/UrlField" android:hint="@string/import_url_hint" android:imeOptions="actionDone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="@string/import_url_help" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <Button android:id="@+id/filePanel" style="@style/ConfigSecondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp"
                android:layout_marginTop="@dimen/ui_section_gap" android:padding="@dimen/ui_field_inset" android:visibility="gone"
                android:drawableStart="@drawable/ic_config_file" android:drawablePadding="16dp"
                android:gravity="start|center_vertical" android:text="@string/import_file_action"
                android:textColor="@color/ink" android:textSize="@dimen/ui_body_text" android:lineSpacingExtra="6dp" />
            <ProgressBar android:id="@+id/importProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="@dimen/ui_section_gap"
                android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/importFeedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_item_gap" android:textSize="@dimen/ui_label_text" android:textColor="@color/ink" android:lineSpacingExtra="4dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.lightboat.app.BackupOptionsView android:id="@+id/importBackupOptions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_item_gap" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_section_gap"
                android:text="@string/import_note" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_section_gap">
        <Button android:id="@+id/importCancel" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:text="@string/import_cancel" />
        <Button android:id="@+id/importAction" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:layout_marginStart="@dimen/ui_item_gap" android:text="@string/import_check" />
    </LinearLayout>
</LinearLayout>
