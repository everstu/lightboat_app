<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_page_inset" android:background="@drawable/bg_config_dialog">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/batchTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/script_batch_title" android:textSize="@dimen/ui_dialog_title" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/script_batch_help" android:textSize="13sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
            <TextView style="@style/FieldLabel" android:layout_marginTop="@dimen/ui_item_gap" android:text="@string/script_batch_label" android:labelFor="@id/batchScriptsInput" />
            <EditText android:id="@+id/batchScriptsInput" style="@style/UrlField" android:singleLine="false"
                android:inputType="textMultiLine|textNoSuggestions" android:gravity="top|start" android:minLines="5" android:maxLines="12"
                android:maxLength="1048576" android:hint="@string/script_batch_hint" android:textSize="@dimen/ui_label_text"
                android:imeOptions="flagNoExtractUi" android:importantForAutofill="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/script_batch_note" android:textSize="12sp" android:textColor="@color/muted" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_item_gap">
        <Button android:id="@+id/cancelBatchScripts" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:text="@string/import_cancel" />
        <Button android:id="@+id/confirmBatchScripts" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:layout_marginStart="@dimen/ui_item_gap" android:text="@string/script_batch_confirm" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
