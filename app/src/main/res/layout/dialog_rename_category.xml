<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="24dp" android:background="@drawable/bg_config_dialog" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/renameTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/category_rename_title" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/closeRename" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_close" app:tint="@color/muted" android:contentDescription="@string/close"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/category_rename_description" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="4dp" />
            <TextView style="@style/FieldLabel" android:layout_marginTop="20dp" android:text="@string/category_rename_select" android:labelFor="@id/selectCategory" />
            <Button android:id="@+id/selectCategory" style="@style/CategoryFilter" android:layout_width="match_parent"
                android:layout_marginTop="10dp" />
            <TextView style="@style/FieldLabel" android:layout_marginTop="20dp" android:text="@string/category_name_label" android:labelFor="@id/categoryNameInput" />
            <EditText android:id="@+id/categoryNameInput" style="@style/UrlField" android:inputType="textCapSentences"
                android:maxLength="60" android:hint="@string/category_name_label" android:imeOptions="actionDone|flagNoExtractUi" />
            <TextView android:id="@+id/renameHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textColor="@color/muted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
        <Button android:id="@+id/cancelRename" style="@style/ConfigSecondary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:text="@string/import_cancel" />
        <Button android:id="@+id/saveRename" style="@style/ConfigPrimary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginStart="12dp" android:text="@string/save_profile" />
    </LinearLayout>
</LinearLayout>
