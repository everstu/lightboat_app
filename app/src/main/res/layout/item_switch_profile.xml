<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:background="@drawable/bg_profile_option" android:clickable="true" android:focusable="true">
    <LinearLayout android:id="@+id/profileContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="80dp"
        android:padding="@dimen/ui_field_inset">
        <TextView android:id="@+id/profileInitial" android:layout_width="36dp" android:layout_height="36dp"
            android:gravity="center" android:background="@drawable/bg_config_soft" android:textSize="20sp"
            android:textColor="@color/accent" android:textStyle="bold" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="@dimen/ui_item_gap" android:layout_marginEnd="@dimen/ui_item_gap"
            android:importantForAccessibility="noHideDescendants">
            <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="@dimen/ui_body_text" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/profileHost" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="middle" />
            <TextView android:id="@+id/profilePlatform" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/profileFavorite" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginEnd="8dp" android:src="@drawable/ic_star" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/profileIndicator" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_chevron" android:importantForAccessibility="no" />
    </LinearLayout>
    <!-- Same floating corner tag as the profile manager card; it never changes the row height. -->
    <TextView android:id="@+id/profileState" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="1dp" android:layout_marginEnd="7dp"
        android:minWidth="48dp" android:paddingHorizontal="3dp"
        android:background="@drawable/bg_profile_state_tag" android:gravity="center"
        android:includeFontPadding="false" android:singleLine="true" android:importantForAccessibility="no"
        android:clickable="false" android:longClickable="false" android:focusable="false"
        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/accent" android:visibility="gone" />
</FrameLayout>
