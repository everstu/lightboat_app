<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target"
    android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="@dimen/ui_item_gap"
    android:background="@drawable/bg_category_filter_row">
    <TextView android:id="@+id/categoryName" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="@dimen/ui_label_text"
        android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no" />
    <TextView android:id="@+id/categoryCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_item_gap" android:textColor="@color/muted" android:textSize="12sp"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:importantForAccessibility="no" />
</LinearLayout>
