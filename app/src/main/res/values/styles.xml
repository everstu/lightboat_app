<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Lightboat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Lightboat.CompactAlert</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Theme.Lightboat" parent="Base.Theme.Lightboat" />
    <style name="Theme.Lightboat.DebugLogs" parent="Theme.Lightboat">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Lightboat.Scanner" parent="Theme.Lightboat">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
    <style name="Theme.Lightboat.ActionDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Lightboat.CompactAlert</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
    <style name="ThemeOverlay.Lightboat.CompactAlert" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/bg_config_dialog</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="dialogPreferredPadding">@dimen/ui_page_inset</item>
        <item name="alertDialogStyle">@style/CompactAlert</item>
        <item name="buttonBarPositiveButtonStyle">@style/CompactAlertPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/CompactAlertSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/CompactAlertSecondary</item>
    </style>
    <style name="ThemeOverlay.Lightboat.DestructiveAlert" parent="ThemeOverlay.Lightboat.CompactAlert">
        <item name="buttonBarPositiveButtonStyle">@style/CompactAlertDestructive</item>
    </style>
    <style name="CompactAlert" parent="AlertDialog.AppCompat">
        <item name="android:layout">@layout/dialog_compact_alert</item>
        <item name="listItemLayout">@layout/item_compact_alert_choice</item>
    </style>
    <style name="CompactAlertPrimary" parent="ConfigPrimary">
        <item name="android:minWidth">72dp</item>
    </style>
    <style name="CompactAlertSecondary" parent="ConfigSecondary">
        <item name="android:minWidth">72dp</item>
    </style>
    <style name="CompactAlertDestructive" parent="CategoryDeleteAction">
        <item name="android:minWidth">72dp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/ui_label_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ConfigAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ui_field_inset</item>
        <item name="android:paddingEnd">@dimen/ui_field_inset</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ui_label_text</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="ConfigPrimary" parent="ConfigAction">
        <item name="android:background">@drawable/bg_compact_action_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ConfigSecondary" parent="ConfigAction">
        <item name="android:background">@drawable/bg_compact_action_secondary</item>
    </style>
    <style name="CategoryDeleteAction" parent="ConfigAction">
        <item name="android:background">@drawable/bg_compact_action_delete</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ProfileFloatingAction">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">48dp</item>
    </style>
    <style name="ScriptOrderAction" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:background">@drawable/bg_script_order_action</item>
    </style>
    <style name="ScriptOrderAction.Remove" parent="ScriptOrderAction">
        <item name="android:background">@drawable/bg_script_remove_action</item>
    </style>
    <style name="ProfileCardAction" parent="ConfigAction">
        <item name="android:minWidth">104dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ProfileCardAction.Primary" parent="ProfileCardAction">
        <item name="android:background">@drawable/bg_profile_action_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="ProfileCardAction.Secondary" parent="ProfileCardAction">
        <item name="android:background">@drawable/bg_profile_action_secondary</item>
    </style>
    <style name="BrowserMenuAction" parent="ConfigSecondary">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_browser_menu_secondary</item>
    </style>
    <style name="BrowserMenuAction.Primary" parent="BrowserMenuAction">
        <item name="android:background">@drawable/bg_browser_menu_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ConfigSegment" parent="ConfigAction">
        <item name="android:background">@drawable/bg_compact_action_segment</item>
        <item name="android:textColor">@color/config_segment_text</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="CategoryFilter" parent="ConfigSecondary">
        <item name="android:layout_height">48dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawableEnd">@drawable/ic_expand</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="FavoriteFilter" parent="ConfigSegment">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:text">@string/favorites_only</item>
    </style>
    <style name="UrlField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ui_touch_target</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">@dimen/ui_field_inset</item>
        <item name="android:textSize">@dimen/ui_body_text</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:inputType">textUri</item>
        <item name="android:singleLine">true</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="NoteField" parent="UrlField">
        <item name="android:inputType">textMultiLine|textNoSuggestions</item>
        <item name="android:singleLine">false</item>
        <item name="android:selectAllOnFocus">false</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:minLines">3</item>
        <item name="android:maxLines">8</item>
        <item name="android:gravity">top|start</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>
</resources>
