<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Lightboat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Theme.Lightboat" parent="Base.Theme.Lightboat" />
    <style name="Theme.Lightboat.DebugLogs" parent="Theme.Lightboat">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Lightboat.Scanner" parent="Theme.Lightboat">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
    <style name="Theme.Lightboat.ActionDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ConfigAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="ConfigPrimary" parent="ConfigAction">
        <item name="android:background">@drawable/bg_config_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ConfigSecondary" parent="ConfigAction">
        <item name="android:background">@drawable/bg_config_secondary</item>
    </style>
    <style name="ConfigSegment" parent="ConfigAction">
        <item name="android:background">@drawable/bg_config_segment</item>
        <item name="android:textColor">@color/config_segment_text</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="CategoryFilter" parent="ConfigSecondary">
        <item name="android:layout_height">48dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawableEnd">@drawable/ic_expand</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="FavoriteFilter" parent="ConfigSegment">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:text">@string/favorites_only</item>
    </style>
    <style name="UrlField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:inputType">textUri</item>
        <item name="android:singleLine">true</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
